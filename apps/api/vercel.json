{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm exec turbo run build --filter=@plantify/api && pnpm --filter @plantify/db migrate:deploy",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": { "api/index.js": { "includeFiles": "dist/**", "maxDuration": 60 } },
  "crons": [{ "path": "/api/internal/reset", "schedule": "0 3 * * *" }]
}
