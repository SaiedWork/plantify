{
  "name": "@plantify/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "echo \"no tests yet\"",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "seed": "tsx --env-file=../../.env src/cli.ts seed",
    "reset": "tsx --env-file=../../.env src/cli.ts reset",
    "generate": "drizzle-kit generate",
    "build": "tsc",
    "images": "tsx scripts/generate-product-images.ts"
  },
  "devDependencies": {
    "@plantify/config": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
